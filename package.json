{
  "name": "react-zangief",
  "version": "1.0.8",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ossan-engineer/react-zangief"
  },
  "packageManager": "pnpm@11.28.0",
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production babel src/lib --extensions '.ts,.tsx' --ignore '**/*.test.tsx,**/*.stories.tsx' --out-dir dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "storybook-to-ghpages"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "7.21.0",
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.20.2",
    "@babel/preset-react": "7.18.6",
    "@babel/preset-typescript": "7.29.7",
    "@storybook/react-vite": "10.6.7",
    "@storybook/storybook-deployer": "2.8.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-inline-import-data-uri": "1.0.1",
    "jsdom": "31.0.1",
    "prettier": "2.8.8",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "storybook": "10.6.7",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.0.0",
    "react-dom": "^17.0.2 || ^18.0.0"
  }
}
